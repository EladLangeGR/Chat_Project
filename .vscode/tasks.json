{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Server",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}/server"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Client",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build All",
            "dependsOn": ["Build Server", "Build Client"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
